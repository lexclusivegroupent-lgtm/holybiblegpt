{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holybiblegpt",
  // Workers Logs and traces. Applied on the next deploy of this config.
  // Logs are kept at 100% while traffic is modest. Traces are sampled at 1%
  // so a deploy does not store a span for every request. Lower
  // logs.head_sampling_rate here if the log volume gets expensive.
  // This does not enable Sentry. SENTRY_DSN is a secret, not a var:
  //   npx wrangler secret put SENTRY_DSN
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  // Worker script handles /api/esv and the account routes in src/api.
  // Every other request is served from static assets. The binding name must
  // be ASSETS: src/worker.ts calls env.ASSETS.fetch,
  // and that call is what applies not_found_handling for routes with no file
  // (client pages and Bible chapters that were not prerendered).
  //
  // 73cd302 (2026-08-18) set "main" without "binding". env.ASSETS was then
  // undefined, so any request that reached the Worker threw
  // `Cannot read properties of undefined (reading 'fetch')` and Cloudflare
  // returned error 1101. Browser navigations still returned HTML because
  // compatibility_date >= 2025-04-01 serves assets for Sec-Fetch-Mode: navigate
  // without invoking the Worker. Crawlers, previews, and other non-navigation
  // fetches did not, which is why most chapter URLs 500'd.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* must hit the Worker even for browser navigations. Otherwise the
    // SPA fallback above would return index.html for /api/esv.
    "run_worker_first": ["/api/*"],
    // Serve /about as 200. /about/ redirects to /about, matching canonical URLs.
    "html_handling": "drop-trailing-slash"
  },
  // Public Stripe return origin. Not a secret. Checkout stays off until
  // STRIPE_SECRET_KEY and a Plus price are set with `wrangler secret put`.
  // Prices: STRIPE_PRICE_ID_MONTHLY, STRIPE_PRICE_ID_YEARLY, and
  // STRIPE_PRICE_ID (monthly fallback). GIFT_URL is a public Payment Link,
  // not a secret. donate.stripe.com is the host for donate links.
  "vars": {
    "APP_URL": "https://holybiblegpt.com",
    "GIFT_URL": "https://donate.stripe.com/3cIcN57qad0l3bA6gAcEw00"
  },
  // Same hour as the old Vercel cron (13:00 UTC). The scheduled handler
  // skips the send when the VAPID secrets are missing, and it does not throw.
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  // Migration 0001_app_storage.sql is already applied on this database.
  // Deploy does not run it again. The SQL only creates tables if they are missing.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holybiblegpt",
      "database_id": "57f368b2-1ece-47f3-9838-896ddbd5eabe",
      "migrations_dir": "migrations"
    }
  ]
  // To enable ESV, add the API key as a Cloudflare secret:
  //   wrangler secret put ESV_API_KEY
  // Get a free ESV API key at: https://api.esv.org
}
