# Server/API keys
GEMINI_API_KEY=your_gemini_api_key_here

# Sentry — leave blank until the projects exist. Do not commit real DSNs.
# Worker (runtime, Cloudflare secret, not a wrangler.jsonc var):
#   npx wrangler secret put SENTRY_DSN
SENTRY_DSN=
# Browser bundle. Vite inlines this at `npm run build`. Set it in the
# Cloudflare Workers build environment and, for the Vercel copy, in Vercel.
# A rebuild is required after it changes. The value is public in the JS bundle.
VITE_SENTRY_DSN=
# Optional, only for uploading source maps. Not required for error capture.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Billing (Stripe) — required for the Pro tier (cloud sync) to work.
# On the Worker, set these with wrangler. Do not commit the values.
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put STRIPE_PRICE_ID
# APP_URL is already https://holybiblegpt.com in wrangler.jsonc.
# The names below are the previous Vercel environment. Leave them empty here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Your deployed app URL, e.g. https://holybiblegpt.com — used for Stripe redirect/return URLs
VITE_APP_URL=

# Vercel KV — stores pro/free status and synced user data
# Create a KV store in the Vercel dashboard (Storage tab) and link it to this project;
# Vercel injects these automatically once linked, but they must exist for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Web Push (daily verse notifications).
# The public key already in components/NotificationOptIn.tsx must be the value
# of VAPID_PUBLIC_KEY. Do not generate a new pair unless that file changes too.
#   npx wrangler secret put VAPID_PUBLIC_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
#   npx wrangler secret put CRON_SECRET
# CRON_SECRET guards the HTTP route /api/push-send-daily. The Worker cron does
# not use it. Generate a long random value; do not commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
