# Server/API keys
GEMINI_API_KEY=your_gemini_api_key_here

# Sentry — leave blank until the projects exist. Do not commit real DSNs.
# Worker (runtime, Cloudflare secret, not a wrangler.jsonc var):
#   npx wrangler secret put SENTRY_DSN
SENTRY_DSN=
# Browser bundle. Vite inlines this at `npm run build`. Set it in the
# Cloudflare Workers build environment and, for the Vercel copy, in Vercel.
# A rebuild is required after it changes. The value is public in the JS bundle.
VITE_SENTRY_DSN=
# Optional, only for uploading source maps. Not required for error capture.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Billing (Stripe) — required for the Pro tier (cloud sync) to work
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Your deployed app URL, e.g. https://holybiblegpt.com — used for Stripe redirect/return URLs
VITE_APP_URL=

# Vercel KV — stores pro/free status and synced user data
# Create a KV store in the Vercel dashboard (Storage tab) and link it to this project;
# Vercel injects these automatically once linked, but they must exist for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Web Push (daily verse notifications) — generate once with the `web-push` package:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY is also hardcoded client-side in components/NotificationOptIn.tsx
# (it's not a secret), but keep both in sync if you ever regenerate the keypair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: set this AND add the same value as the Cron Job secret in Vercel so
# /api/push-send-daily only runs when triggered by Vercel Cron, not by anyone who finds the URL.
CRON_SECRET=
