{
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/bible/kjv.json",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/",
            "has": [{ "type": "host", "value": "holy-bible-gpt-new.vercel.app" }],
            "destination": "https://holybiblegpt.com/",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "holy-bible-gpt-new.vercel.app" }],
            "destination": "https://holybiblegpt.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/push-send-daily",
            "schedule": "0 13 * * *"
        }
    ]
}